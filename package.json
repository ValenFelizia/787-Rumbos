{
  "name": "my-v0-project",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "audit:deps": "npm audit --audit-level=high",
    "build:e2e": "node --env-file=e2e.env node_modules/next/dist/bin/next build",
    "test:e2e": "npm run build:e2e && npm run test:e2e:ci",
    "test:e2e:ci": "node --env-file=e2e.env node_modules/@playwright/test/cli.js test",
    "test:e2e:ui": "npm run build:e2e && node --env-file=e2e.env node_modules/@playwright/test/cli.js test --ui",
    "start": "next start"
  },
  "dependencies": {
    "@vercel/analytics": "1.6.1",
    "autoprefixer": "^10.5.4",
    "lucide-react": "^0.577.0",
    "next": "^15.5.22",
    "react": "^19",
    "react-dom": "^19",
    "react-fast-marquee": "^1.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15.5.23",
    "postcss": "^8.5",
    "tailwindcss": "^4.1.9",
    "typescript": "^5"
  }
}
