{
  "name": "my-v0-project",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "audit:deps": "npm audit --audit-level=high",
    "build:e2e": "node --env-file=e2e.env --env-file-if-exists=.env node_modules/next/dist/bin/next build",
    "test:e2e": "npm run build:e2e && npm run test:e2e:ci",
    "test:e2e:ci": "node --env-file=e2e.env --env-file-if-exists=.env node_modules/@playwright/test/cli.js test",
    "test:e2e:ui": "npm run build:e2e && node --env-file=e2e.env --env-file-if-exists=.env node_modules/@playwright/test/cli.js test --ui",
    "snapshot:catalog": "tsx scripts/catalog-snapshot.ts",
    "payload": "payload",
    "cms:migrate": "payload migrate",
    "cms:seed": "payload run scripts/seed-catalog.ts",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "test:unit": "node --import tsx --test lib/catalog/logic.test.ts lib/catalog/promo.test.ts lib/whatsapp-inquiry.test.ts payload/editorial/diff.test.ts payload/editorial/asistente.test.ts payload/mcp/overrideAccess.test.mjs",
    "vercel-build": "payload migrate && next build",
    "test:parity": "payload run scripts/catalog-parity.ts",
    "snapshot:html": "node scripts/html-snapshot.mjs",
    "snapshot:compare": "node scripts/html-snapshot.mjs --compare",
    "start": "next start"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.75.0",
    "@payloadcms/next": "3.75.0",
    "@payloadcms/plugin-mcp": "3.75.0",
    "@payloadcms/richtext-lexical": "3.75.0",
    "@payloadcms/storage-vercel-blob": "3.75.0",
    "@payloadcms/translations": "3.75.0",
    "@payloadcms/ui": "3.75.0",
    "@vercel/analytics": "1.6.1",
    "autoprefixer": "^10.5.4",
    "graphql": "16.11.0",
    "lucide-react": "^0.577.0",
    "next": "^15.5.24",
    "payload": "3.75.0",
    "react": "^19",
    "react-dom": "^19",
    "react-fast-marquee": "^1.6.5",
    "server-only": "0.0.1",
    "sharp": "0.34.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@modelcontextprotocol/sdk": "1.26.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15.5.25",
    "postcss": "^8.5",
    "tailwindcss": "^4.1.9",
    "tsx": "4.21.0",
    "typescript": "^5"
  }
}
